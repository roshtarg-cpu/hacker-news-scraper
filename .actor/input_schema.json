{
  "schemaVersion": "1.0",
  "schema": {
    "title": "Hacker News Scraper Input",
    "type": "object",
    "properties": {
      "maxResults": {
        "type": "integer",
        "title": "Max Results",
        "description": "Maximum number of results to return",
        "default": 50
      },
      "proxyConfiguration": {
        "type": "object",
        "title": "Proxy Configuration",
        "description": "Proxy configuration",
        "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] }
      }
    }
  }
}
